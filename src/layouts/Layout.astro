---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'LIMASYNC SOLUTIONS | Webs, Tiendas Online, ERP/CRM y Apps Móviles en Lima',
  description = 'Estudio de software en Lima, Perú. Webs corporativas, tiendas online, sistemas ERP y CRM y apps móviles a medida con entrega ágil y garantía 50/50.',
  lang = 'es',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://limasync.com');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Space+Grotesk:wght@600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@700;800;900&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Space+Grotesk:wght@600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400;1,600&family=Space+Grotesk:wght@600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <meta name="robots" content="index, follow, noarchive, nosnippet" />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LimaSync Solutions" />
    <meta property="og:image" content="https://limasync.com/og-image.png" />
    <meta property="og:locale" content="es_PE" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://limasync.com/og-image.png" />
    <!-- Structured Data (Schema.org) for SEO 100 -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "LimaSync Solutions",
        "url": "https://limasync.com",
        "logo": "https://limasync.com/favicon.svg",
        "description": "Estudio de software en Lima, Perú. Webs corporativas, tiendas online, sistemas ERP y CRM y apps móviles a medida con entrega ágil y garantía 50/50.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Lima",
          "addressCountry": "PE"
        },
        "priceRange": "$$"
      }
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Protection against scraping, context menu & inspecting
      document.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        return false;
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'F12' || e.keyCode === 123) {
          e.preventDefault();
          return false;
        }
        const cmdOrCtrl = e.metaKey || e.ctrlKey;
        if (cmdOrCtrl && (e.key === 'u' || e.key === 'U' || e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          return false;
        }
        if (cmdOrCtrl && (e.shiftKey || e.altKey) && (e.key === 'i' || e.key === 'I' || e.key === 'j' || e.key === 'J' || e.key === 'c' || e.key === 'C')) {
          e.preventDefault();
          return false;
        }
      });
    </script>
  </body>
</html>
