---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import MinimalHero from '../components/MinimalHero';
import ServicesSection from '../components/ServicesSection';
import ProcessSection from '../components/ProcessSection';
import PricingSection from '../components/PricingSection';
import MinimalContactCta from '../components/MinimalContactCta';
import FloatingWhatsApp from '../components/FloatingWhatsApp';

const EMAIL = "limasync0@gmail.com";
---

<Layout
  lang="es"
  title="LIMASYNC SOLUTIONS | Fácil, Rápido, LimaSync · Webs en 72h"
  description="Fácil, rápido, LimaSync. Páginas web, cartas digitales QR y software comercial entregados en 72 horas con garantía 50/50 en Lima, Perú."
>
  <Header client:load lang="es" />
  <main id="top">
    <MinimalHero client:load lang="es" />
    <ServicesSection client:visible lang="es" />
    <ProcessSection client:visible lang="es" />
    <PricingSection client:visible lang="es" />
    <MinimalContactCta client:visible lang="es" email={EMAIL} />
  </main>
  <FloatingWhatsApp client:idle lang="es" />
</Layout>
