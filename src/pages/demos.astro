---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import DemoShowcase from '../components/DemoShowcase';
import FloatingWhatsApp from '../components/FloatingWhatsApp';

const WHATSAPP =
  "https://wa.me/51906920958?text=" +
  encodeURIComponent("Hola LimaSync Solutions, vi el catálogo de demos y quiero cotizar la plantilla para mi rubro.");
---

<Layout
  lang="es"
  title="Demos en Vivo de Sitios Web en Lima | LimaSync Solutions"
  description="Prueba en vivo nuestras 7 demos interactivas para Restaurantes, Clínicas, Abogados, Tiendas, Servicios Técnicos, Academias y Hoteles en Lima. Entrega en 72h por S/ 499."
>
  <Header client:load lang="es" />

  <main style="padding-top: 2rem;">
    <!-- Top Hero Demos -->
    <section style="padding-block: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line); background: var(--paper-2);">
      <div class="wrap" style="text-align: center; max-width: 860px;">
        <p class="kicker" style="color: var(--accent-strong); margin-bottom: 0.8rem;">
          Catálogo Oficial · Demos Interactivas en Vivo
        </p>
        <h1 style="font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.25rem;">
          Prueba Nuestras 7 Demos en Vivo
        </h1>
        <p style="color: var(--ink-soft); font-size: 1.12rem; line-height: 1.6; max-width: 680px; margin: 0 auto 2rem;">
          Cada demo en vivo incluye las funciones reales que necesita tu negocio para vender: cartas QR, cálculo de envíos, cotizador distrital, agendamiento de citas y pedidos directos a WhatsApp.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="#demos" class="btn btn-accent">
            Explorar Demos en Vivo ↓
          </a>
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn">
            Pedir Asesoría por WhatsApp →
          </a>
        </div>
      </div>
    </section>

    <!-- Showcase Component -->
    <DemoShowcase client:load lang="es" />

    <!-- Help Banner -->
    <section style="padding-block: 4rem; border-top: 1px solid var(--line); background: var(--paper-2); text-align: center;">
      <div class="wrap" style="max-width: 760px;">
        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; margin-bottom: 1rem;">
          ¿Tienes un negocio con necesidades específicas?
        </h2>
        <p style="color: var(--ink-soft); font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
          Adaptamos la estructura, colores, textos y pasarelas de pago a tu modelo de ventas exacto. Entregamos tu web completa y funcional en 72 horas por S/ 499 (50% de anticipo y 50% contra entrega).
        </p>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-accent" style="padding: 0.85rem 1.75rem; font-size: 1rem;">
          Hablar con un Ingeniero por WhatsApp →
        </a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} LIMASYNC SOLUTIONS — Demos en Vivo</span>
      <span>
        <a href="/">← Volver al Inicio</a>
        {" · "}
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer">WhatsApp (+51 906 920 958)</a>
      </span>
    </div>
  </footer>

  <FloatingWhatsApp client:load lang="es" />
</Layout>
