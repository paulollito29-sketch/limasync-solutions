---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import MinimalHero from '../../components/MinimalHero';
import ServicesSection from '../../components/ServicesSection';
import ProcessSection from '../../components/ProcessSection';
import PricingSection from '../../components/PricingSection';
import MinimalContactCta from '../../components/MinimalContactCta';
import FloatingWhatsApp from '../../components/FloatingWhatsApp';

const EMAIL = "limasync0@gmail.com";
---

<Layout
  lang="de"
  title="LIMASYNC SOLUTIONS | Websites, Systeme & Software in 72 Stunden"
  description="Web-Engineering, Unternehmenssysteme und maßgeschneiderte Software in Lima, Peru. Geliefert in 72 Stunden mit 50/50-Modell."
>
  <Header client:load lang="de" />
  <main id="top">
    <MinimalHero client:load lang="en" />
    <ServicesSection client:visible lang="en" />
    <ProcessSection client:visible lang="en" />
    <PricingSection client:visible lang="en" />
    <MinimalContactCta client:visible lang="en" email={EMAIL} />
  </main>
  <FloatingWhatsApp client:idle lang="en" />
</Layout>
