---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import DemoShowcase from '../../components/DemoShowcase';
import PricingSection from '../../components/PricingSection';
import FloatingWhatsApp from '../../components/FloatingWhatsApp';

const WHATSAPP =
  "https://wa.me/51906920958?text=" +
  encodeURIComponent("Hello LimaSync Solutions, I want to get a quote for my website");

const EMAIL = "limasync0@gmail.com";

const services = [
  {
    num: "01",
    title: "Express Web Development",
    desc: "High-impact corporate websites and landing pages engineered to sell. Ultra-fast, responsive, mobile-first, and delivered in 72 hours.",
    tags: ["Landing pages", "72h Delivery", "WhatsApp Checkout", ".com Domain"],
  },
  {
    num: "02",
    title: "Dashboards & Business Portals",
    desc: "Management dashboards and real-time analytics so you steer your business with actual metrics, not guesswork.",
    tags: ["Dashboards", "Real-Time Reports", "KPI Tracking", "Data Visualization"],
  },
  {
    num: "03",
    title: "Automation & Custom Bots",
    desc: "Turn repetitive chores into autonomous workflows: instant WhatsApp alerts, automated email reports, and cross-platform syncing.",
    tags: ["Workflows", "WhatsApp Alerts", "API Integrations", "Google Sheets"],
  },
  {
    num: "04",
    title: "POS & Digital QR Menus for Restaurants",
    desc: "Table management, digital QR menus, and direct ordering to kitchen or WhatsApp, from ordering to register closing.",
    tags: ["Digital QR Menu", "WhatsApp Orders", "Table Control", "Fast POS"],
  },
];

const steps = [
  {
    num: "01",
    title: "Choose Your Architecture",
    desc: "We pick the ideal template based on your industry (Dining, Healthcare, Legal, Retail, or Services).",
  },
  {
    num: "02",
    title: "50% Kickoff Deposit (S/ 249 / ~$68)",
    desc: "Send us your logo, imagery, and contact info. We guarantee immediate project kickoff with a clear agreement.",
  },
  {
    num: "03",
    title: "72-Hour Express Development",
    desc: "We configure your custom domain, SSL certificate, responsive layout, and direct WhatsApp buttons in record time.",
  },
  {
    num: "04",
    title: "Live Launch & Training",
    desc: "You test the live site, pay the remaining 50% (S/ 249), and we conduct a 15-minute video call to onboard you.",
  },
];

const stripItems = [
  "72-Hour Delivery",
  "Custom Built Architectures",
  "Sales Automation",
  "Direct WhatsApp Checkout",
  ".com Domain & SSL Included",
  "Continuous Support",
];

const rubrosPreviewEn = [
  { icon: "🍽️", name: "Dining & Bars", desc: "Digital QR menu, delivery calculator and WhatsApp ordering", slug: "restaurante", badge: "Popular" },
  { icon: "🩺", name: "Health & Aesthetics", desc: "Online booking, treatment pricing and 24/7 emergencies", slug: "salud", badge: "Professional" },
  { icon: "⚖️", name: "Legal & Corporate", desc: "Confidential assessment, trademarks and business law", slug: "legal", badge: "Corporate" },
  { icon: "🛍️", name: "Fashion & Retail", desc: "Size/color selectors, live shopping cart and instant checkout", slug: "tienda", badge: "E-Commerce" },
  { icon: "🔧", name: "Technical Services", desc: "District cost calculator and 45-minute emergency dispatch", slug: "servicios", badge: "Conversion" },
  { icon: "🎓", name: "Education & Coaching", desc: "Course catalog, syllabus downloads and WhatsApp enrollment", slug: "educacion", badge: "Training" },
  { icon: "🏨", name: "Hotels & Airbnb", desc: "Nightly rates, stay calculator and direct WhatsApp bookings", slug: "hoteleria", badge: "Tourism" },
];
---

<Layout
  lang="en"
  title="LIMASYNC SOLUTIONS — High-Impact Websites & Automation in 72 Hours"
  description="Web development, software & automation agency in Lima, Peru. High-converting websites and systems delivered in 72 hours with verified delivery."
>
  <Header client:load lang="en" />
  
  <main id="top">
    <!-- HERO -->
    <div class="wrap">
      <div class="hero">
        <div>
          <p class="kicker">Web Agency · Software · Automation</p>
          <h1>
            Your business online,
            <br />
            <span class="outline">in 72 hours with verified delivery.</span>
          </h1>
          <p class="hero-sub">
            We build high-impact websites, client dashboards, and digital workflows in Lima, Peru.
            No convoluted contracts or hidden fees: 50% upfront and 50% upon verified delivery.
          </p>
          <div class="hero-actions">
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-accent">
              Chat on WhatsApp →
            </a>
            <a href="#demos" class="btn">
              Browse Live Demos ↓
            </a>
          </div>
          <p class="hero-note">// 72-hour delivery · .com domain & SSL included · Continuous support</p>
        </div>

        <div class="hero-visual">
          <div class="hero-mockup-wrap">
            <img
              src="/images/hero_mockup.png"
              alt="LimaSync responsive web platform and mobile application"
              class="hero-mockup-img"
              width="1024"
              height="1024"
              loading="eager"
            />
          </div>
          <span class="chip chip-1">Custom Built</span>
          <span class="chip chip-2">72 Hours</span>
        </div>
      </div>
    </div>

    <!-- STRIP / MARQUEE -->
    <div class="strip" aria-hidden="true">
      <div class="strip-inner">
        {[...stripItems, ...stripItems].map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </div>

    <!-- 01 SERVICES -->
    <section id="services">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" style="color: var(--accent-strong);">
              Systems Engineering Solutions
            </p>
            <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800;">What we do</h2>
          </div>
          <span class="sec-num">01 / Services</span>
        </div>

        <div class="svc">
          {services.map((s) => (
            <div class="svc-row">
              <span class="svc-num">{s.num}</span>
              <h3>{s.title}</h3>
              <div>
                <p>{s.desc}</p>
                <div class="svc-tags">
                  {s.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 LIVE DEMOS -->
    <section id="demos" style="padding-block: clamp(3.5rem, 6vw, 5.5rem); border-top: 1px solid var(--line);">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" style="color: var(--accent-strong);">
              Specialized Web Architectures · 72-Hour Delivery
            </p>
            <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800;">
              Live Demos
            </h2>
          </div>
          <span class="sec-num">02 / Demos</span>
        </div>

        <p style="max-width: 72ch; color: var(--ink-soft); margin-bottom: 2.5rem; font-size: 1.05rem; line-height: 1.6;">
          We have engineered 7 interactive live demos so you can experience real checkout flows, table bookings, and calculators before hiring. Select a demo or visit our full interactive catalog.
        </p>

        <!-- Preview Grid of all 7 rubros -->
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;"
        >
          {rubrosPreviewEn.map((r) => (
            <a
              href={`/templates/${r.slug}`}
              style="background: var(--paper-2); border: 1px solid var(--line); border-radius: 12px; padding: 1.4rem; text-decoration: none; color: inherit; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s;"
            >
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                  <span style="font-size: 1.8rem;">{r.icon}</span>
                  <span style="background: rgba(0,0,0,0.06); border: 1px solid var(--line); font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600;">
                    {r.badge}
                  </span>
                </div>
                <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.4rem;">{r.name}</h3>
                <p style="color: var(--ink-soft); font-size: 0.88rem; line-height: 1.4; margin-bottom: 1rem;">
                  {r.desc}
                </p>
              </div>
              <span style="font-weight: 700; font-size: 0.85rem; color: var(--accent-strong); display: inline-flex; align-items: center; gap: 0.3rem;">
                Test Live Demo ↗
              </span>
            </a>
          ))}
        </div>

        <!-- Big CTA redirecting to /en/demos -->
        <div style="background: var(--ink); color: var(--paper); border-radius: 16px; padding: clamp(2rem, 4vw, 3rem); text-align: center; margin-top: 2rem;">
          <h3 style="font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 800; margin-bottom: 0.75rem; color: #fff;">
            Looking for the full interactive catalog with filters?
          </h3>
          <p style="color: rgba(255,255,255,0.75); max-width: 580px; margin: 0 auto 1.8rem; font-size: 1rem; line-height: 1.5;">
            Explore our dedicated Demos page featuring interactive category filtering, live WhatsApp simulators, and instant project pricing.
          </p>
          <a
            href="/en/demos"
            class="btn btn-accent"
            style="padding: 0.95rem 2.2rem; font-size: 1.05rem; font-weight: 800; border-radius: 8px; display: inline-block;"
          >
            Open Dedicated Demos Catalog Page →
          </a>
        </div>
      </div>
    </section>

    <!-- 03 PRICING -->
    <PricingSection client:visible lang="en" />

    <!-- 04 PROCESS -->
    <section id="process" style="padding-block: clamp(3.5rem, 6vw, 5.5rem); border-top: 1px solid var(--line);">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" style="color: var(--accent-strong);">
              72-Hour Agile Methodology
            </p>
            <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800;">How we work</h2>
          </div>
          <span class="sec-num">04 / Process</span>
        </div>
        <div class="steps">
          {steps.map((st) => (
            <div class="step">
              <span class="step-num">{st.num}</span>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section id="contact" class="cta">
      <div class="wrap">
        <div>
          <h2>Ready to get your business online in 72 hours?</h2>
          <p>
            Message us on WhatsApp with your business name and industry. In 10 minutes
            we will show you our recommended live demo and schedule kickoff with just S/ 249 (~$68) upfront.
          </p>
          <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn">
            Chat on WhatsApp →
          </a>
        </div>
        <div class="cta-mail">
          <b>{EMAIL}</b>
          WhatsApp +51 906 920 958 · Lima · San Isidro · Miraflores · Remote Worldwide
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} LIMASYNC SOLUTIONS — Web Agency & Automation</span>
      <span>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer">
          WhatsApp (+51 906 920 958)
        </a>
        {" · "}
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        {" · "}
        <a href="#top">Top ↑</a>
      </span>
    </div>
  </footer>

  <FloatingWhatsApp client:load lang="en" />
</Layout>
