---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import FaqSection from '../components/FaqSection';
import MinimalContactCta from '../components/MinimalContactCta';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import CustomCursor from '../components/CustomCursor';

const EMAIL = "limasync0@gmail.com";
---

<Layout lang="es" title="Preguntas Frecuentes · LimaSync Solutions" description="Todo sobre nuestra garantía 50/50, tiempos de entrega de 72h, dominios y costos de software en LimaSync.">
  <Header client:load lang="es" />
  <main id="top">
    <FaqSection client:load lang="es" />
    <MinimalContactCta client:load lang="es" email={EMAIL} showFaqLink={false} />
  </main>
  <FloatingWhatsApp client:idle lang="es" />
  <CustomCursor client:load />
</Layout>
